# ==========================================
# Affiliate Automation & DevOps Learning Bot
# ==========================================

# 1. Safety Switches
DRY_RUN=true
USE_AI=true

# 2. Cuelinks Configuration (v3 API)
CUELINKS_API_KEY=
CUELINKS_API_URL=https://developers.cuelinks.com/pub_api/v3
CUELINKS_AUTH_SCHEME=Token
# Cuelinks publisher/account id used by the static linksredirect builder.
# CONFIRM this is your own account before going live.
CUELINKS_CID=

# 3. AJIO ACE Program (Trackier click domain)
# Copy these from the AJIO ACE dashboard. Never commit real keys.
AJIO_API_KEY=
AJIO_CAMPAIGN_ID=
AJIO_PUB_ID=
AJIO_TRACKING_BASE=
# Product feed URL from the AJIO ACE/Trackier dashboard (JSON or CSV).
# Leave empty to use the curated data/shirts.csv inventory.
AJIO_FEED_URL=

# 4. Google Gemini AI Service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 5. Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@YourDealsChannel

# 6. Google Sheet inbox (mobile-friendly)
# Preferred: share the sheet with the service-account email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=deals
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
# Fallback: publish the sheet as CSV and paste that URL here.
GOOGLE_SHEET_CSV_URL=
# Delete a row from the sheet after it is posted live? Default false keeps the
# sheet intact (the SQLite "seen" ledger already prevents reposting).
SHEET_CLEAR_AFTER_POST=false
# Optional: Apps Script webhook that removes processed rows after a run.
SHEET_CLEAR_WEBHOOK_URL=
SHEET_CLEAR_SECRET=

# 7. Database & Application Paths
DB_PATH=data/affiliate.db
DEALS_CSV=data/sample_deals.csv
SHIRTS_CSV=data/shirts.csv
MAX_POSTS_PER_RUN=3

# 8. Shirt publishing plan (one shirt = one post)
# 0 = post the whole sheet in one run (manual testing only).
MAX_POSTS_PER_DAY=100
POST_INTERVAL_SECONDS=600
# V1 uses only the Google Sheet (manual). Set true to also post data/shirts.csv.
ALLOW_CSV_INVENTORY=false
# Testing only: repost sheet rows that are already marked as seen.
FORCE_REPOST=false
# Testing only: delete posts/metrics/seen history before the run (HARD RESET).
RESET_SEEN_CACHE=false

# 9. Business target (confirmed commission only, from Vibconnect)
MONTHLY_TARGET_INR=2000
